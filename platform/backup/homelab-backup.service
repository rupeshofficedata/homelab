[Unit]
Description=Nightly HomeLab backup to the external drive (restic)
After=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/homelab/backup.sh
# restic needs a cache folder. systemd creates one and sets $CACHE_DIRECTORY.
CacheDirectory=restic
# Run at low priority so the computer stays responsive.
Nice=10
IOSchedulingClass=idle
