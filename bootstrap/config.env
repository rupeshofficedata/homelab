# config.env - the settings you may want to change.
# Every script reads this file (through lib.sh).
# This repo is public: never put passwords or keys in here.
#
# To change a value only on your own machine, create bootstrap/config.local.env
# and set the same variable there. That file is ignored by git.

# Folder that holds all HomeLab data (k3s state and app data).
HOMELAB_ROOT=/srv/homelab

# External drive that stores the backups.
# BACKUP_LABEL is the drive's filesystem label. BACKUP_MOUNT is where it appears.
BACKUP_LABEL="homelab-backup"
BACKUP_MOUNT=/mnt/backup

# Containers to stop before installing k3s, to free memory.
# A regular expression matched against container names. Empty = stop nothing.
# Example: STOP_CONTAINERS_REGEX='^(test-|demo-)'
STOP_CONTAINERS_REGEX=''

# Where the scripts save the kubeconfig (the file kubectl uses to find the cluster).
# A separate file means your normal ~/.kube/config is never touched.
KUBECONFIG_OUT="$HOME/.kube/homelab"

# The age private key that unlocks the encrypted secrets.
# Never commit it. Back it up (see docs/secrets.md).
AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
