# config.env - the ONLY place with machine-specific values.
# Sourced by scripts/lib.sh. Committed to a public repo: never put secrets here.

# Where all homelab data lives. /srv is its own btrfs subvolume (@srv) and is
# not covered by snapper, so photo churn cannot bloat snapshots.
HOMELAB_ROOT=/srv/homelab

# External backup drive (restic target), found by filesystem label.
BACKUP_LABEL="Backup Plus"
BACKUP_MOUNT=/mnt/backup

# Containers stopped to free RAM (regex on container names). Others are untouched.
STOP_REGEX='^(opssquad|visitorcounter|jenkins)'

# Separate kubeconfig so existing kind contexts in ~/.kube/config stay intact.
KUBECONFIG_OUT="$HOME/.kube/homelab"

# age private key. Never commit it; back it up (see docs/secrets.md).
AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
